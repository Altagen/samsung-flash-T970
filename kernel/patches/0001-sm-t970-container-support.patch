diff --git a/drivers/input/keyboard/hall_ic_wacom.c b/drivers/input/keyboard/hall_ic_wacom.c
index a13324995..91e78a18c 100644
--- a/drivers/input/keyboard/hall_ic_wacom.c
+++ b/drivers/input/keyboard/hall_ic_wacom.c
@@ -56,12 +56,16 @@ static void wacom_cover_work(struct work_struct *work)
 		container_of(work, struct hall_drvdata,
 				wacom_cover_dwork.work);
 
-	hall_wacom_status = gpio_get_value(ddata->gpio_wacom_cover);
+	/* Cover detection disabled: always report OPEN.
+	 * The back cover magnet triggers the hall sensor whenever the cover
+	 * is folded against the tablet (including during S Pen use), causing
+	 * Android to blank the screen. Stock Samsung kernel did not exhibit
+	 * this behaviour. Hardcode OPEN so Android never enters cover-sleep. */
+	hall_wacom_status = 1;
 
-	pr_info("keys:%s #1 : %d\n", __func__, hall_wacom_status);
+	pr_info("keys:%s : cover detection disabled, reporting OPEN\n", __func__);
 
-	input_report_switch(ddata->input,
-			SW_MACHINE_COVER, !hall_wacom_status);
+	input_report_switch(ddata->input, SW_MACHINE_COVER, 0);
 	input_sync(ddata->input);
 }
 
@@ -117,7 +121,12 @@ static void init_hall_ic_wacom_irq(struct hall_drvdata *ddata)
 	int ret = 0;
 	int irq = ddata->irq_wacom_cover;
 
-	hall_wacom_status = gpio_get_value(ddata->gpio_wacom_cover);
+	/* Do not read GPIO at init: Samsung Android reads hall_wacom_detect sysfs
+	 * early (t~46s) before coverType=0 is established (t~49s). Reading GPIO
+	 * here with S Pen in slot gives hall_wacom_status=0 (CLOSE), which
+	 * triggers a spurious cover_close sleep. Keep initial value=1 (OPEN)
+	 * so Android sees OPEN until wacom_hall_open fires (500ms after Android
+	 * opens the device, when coverType=0 is already known). */
 
 	INIT_DELAYED_WORK(&ddata->wacom_cover_dwork, wacom_cover_work);
 
